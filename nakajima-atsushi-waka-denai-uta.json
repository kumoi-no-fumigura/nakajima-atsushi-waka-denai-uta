   "no": 66,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "弱き蘆弱きがまゝに美しく伸びんとするを見れば切なしや",
   "sachu": "",
   "poems": []
  },
  {
   "id": "nakajima-atsushi-waka-denai-uta-000067",
   "pid": "aozora",
   "pages": [],
   "no": 67,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "人類の滅亡の前に凝然と懼れはせねど哀しかりけり",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "滅亡",
     "r": "ほろび"
    }
   ]
  },
  {
