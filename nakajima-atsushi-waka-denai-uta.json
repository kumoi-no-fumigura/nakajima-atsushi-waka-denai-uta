   "pid": "aozora",
   "pages": [],
   "no": 73,
   "maki": "",
   "bu": "",
   "dai": "石とならまほしき夜の歌　八首",
   "kotobagaki": "",
   "author": "",
   "text": "石となれ石は怖れも苦しみも憤りもなけむはや石となれ",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "憤",
     "r": "いか"
    }
   ]
  },
  {
