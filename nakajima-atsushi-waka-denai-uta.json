   "no": 76,
   "maki": "",
   "bu": "",
   "dai": "石とならまほしき夜の歌　八首",
   "kotobagaki": "",
   "author": "",
   "text": "眼瞑づれば氷の上を風が吹く我は石となりて轉びて行くを",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "眼",
     "r": "め"
    },
