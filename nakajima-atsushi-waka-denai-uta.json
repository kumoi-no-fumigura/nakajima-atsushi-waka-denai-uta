   "maki": "",
   "bu": "",
   "dai": "石とならまほしき夜の歌　八首",
   "kotobagaki": "",
   "author": "",
   "text": "あな暗や冷たき風がゆるく吹く我は墮ち行くも隕石のごと",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "暗",
     "r": "くら"
    }
   ]
