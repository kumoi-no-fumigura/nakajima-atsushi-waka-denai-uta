    {
     "a": "太沖",
     "r": "たいちゆう"
    },
    {
     "a": "温",
     "r": "あたた"
    },
    {
     "a": "地球",
     "r": "ほし"
    }
   ]
  },
  {
   "id": "nakajima-atsushi-waka-denai-uta-000058",
   "pid": "aozora",
   "pages": [],
   "no": 58,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "おしなべて暗昧きが中に燦然と人類の叡智光るたふとし",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "暗昧",
     "r": "くら"
    }
   ]
  },
  {
   "id": "nakajima-atsushi-waka-denai-uta-000059",
   "pid": "aozora",
   "pages": [],
   "no": 59,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "この地球の人類の文化の明るさよ背後の闇に浮出て美し",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "地球",
     "r": "ほし"
    },
    {
     "a": "人類",
     "r": "ひと"
    },
    {
     "a": "背後",
