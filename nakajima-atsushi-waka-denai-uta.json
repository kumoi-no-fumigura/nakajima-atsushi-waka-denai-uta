   "pages": [],
   "no": 70,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "ありのまゝこの人生を愛し行かむこの心よしと頷きにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "nakajima-atsushi-waka-denai-uta-000071",
