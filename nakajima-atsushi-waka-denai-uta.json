   "pid": "aozora",
   "pages": [],
   "no": 78,
   "maki": "",
   "bu": "",
   "dai": "石とならまほしき夜の歌　八首",
   "kotobagaki": "",
   "author": "",
   "text": "たまきはるいのち寂しく見つめけり冷たき星の上にわれはゐる",
   "sachu": "",
   "poems": []
