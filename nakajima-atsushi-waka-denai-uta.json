   "no": 64,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "いつか來む滅亡知れれば人間の生命いや美しく生きむとするか",
   "sachu": "",
   "poems": [],
   "ruby": [
