   "pages": [],
   "no": 77,
   "maki": "",
   "bu": "",
   "dai": "石とならまほしき夜の歌　八首",
   "kotobagaki": "",
   "author": "",
   "text": "腐れたる魚のまなこは光なし石となる日を待ちて我がゐる",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "魚",
     "r": "うを"
    }
