   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "あるがまゝ醜きがまゝに人生を愛せむと思ふ他に途なし",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "他",
     "r": "ほか"
    },
    {
     "a": "途",
     "r": "みち"
    }
   ]
  },
  {
