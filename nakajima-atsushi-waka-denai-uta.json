   "pages": [],
   "no": 65,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "みづからの運命知りつゝなほ高く上らむとする人間よ切なし",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
     "a": "運命",
     "r": "さだめ"
