   "pid": "aozora",
   "pages": [],
   "no": 68,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "しかすがになほ我はこの生を愛す喘息の夜の苦しかりとも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "nakajima-atsushi-waka-denai-uta-000069",
