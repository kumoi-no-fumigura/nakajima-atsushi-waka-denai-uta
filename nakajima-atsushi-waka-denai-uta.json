  {
   "id": "nakajima-atsushi-waka-denai-uta-000056",
   "pid": "aozora",
   "pages": [],
   "no": 56,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "ぬばたまの宇宙の闇に一ところ明るきものあり人類の文化",
   "sachu": "",
   "poems": []
  },
  {
   "id": "nakajima-atsushi-waka-denai-uta-000057",
