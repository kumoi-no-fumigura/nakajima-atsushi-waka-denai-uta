   "pages": [],
   "no": 60,
   "maki": "",
   "bu": "",
   "dai": "憐れみ讚ふるの歌",
   "kotobagaki": "",
   "author": "",
   "text": "たとふれば鑛脈にひそむ琅玕か愚昧の中に叡智光れる",
   "sachu": "",
   "poems": [],
   "ruby": [
    {
